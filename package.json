{
  "name": "rea-electrico",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicación web para cálculo y diseño de instalaciones eléctricas (fase 1)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @rea/web dev",
    "build": "pnpm --filter @rea/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "schema": "tsx packages/core/scripts/generate-schema.ts",
    "norm:extraer-nom-2012": "pnpm --filter @rea/norm-data extract:nom-2012",
    "norm:construir-nom-2012": "pnpm --filter @rea/norm-data build:nom-2012",
    "norm:construir-iec-2001": "tsx packages/norm-data/scripts/build-iec-60364-2001.ts",
    "norm:importar-nom-externa": "tsx packages/norm-data/scripts/importar-nom-externa.ts",
    "norm:cotejar-nom-externa": "tsx packages/norm-data/scripts/cotejar-nom-externa.ts",
    "norm:verificar": "tsx packages/norm-data/scripts/verify.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
